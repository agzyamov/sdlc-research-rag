# Copy to .env and fill in. .env is gitignored.

# --- LLM backends (ADR-0015): each role picks anthropic | gateway | local ---
# Anthropic (default): the Claude API. Set a key, or use `ant auth login --profile sdlcrag`.
ANTHROPIC_API_KEY=
# SDLCRAG_ANTHROPIC_PROFILE=sdlcrag

# Gateway (optional): any OpenAI- or Azure-OpenAI-compatible LLM gateway. Keep URL/key ONLY here.
# SDLCRAG_GATEWAY_BASE_URL=
# SDLCRAG_GATEWAY_API_KEY=
# SDLCRAG_GATEWAY_API_STYLE=azure       # azure (deployment names) | openai
# SDLCRAG_GATEWAY_API_VERSION=2024-10-21

# Local (optional, $0/offline): Ollama on this machine. Install it, then: ollama pull qwen3.5:9b
SDLCRAG_LOCAL_BASE_URL=http://localhost:11434/v1

# Role -> backend + model. On a gateway, model names are its deployment names.
SDLCRAG_LLM_BACKEND=anthropic              # final answers
SDLCRAG_LLM_MODEL=claude-sonnet-5-5
SDLCRAG_JUDGE_BACKEND=anthropic            # evaluation judge
SDLCRAG_JUDGE_MODEL=claude-sonnet-5-5
# Bulk roles: a cheap model on the gateway. For $0/offline: backend=local, model=qwen3.5:9b
SDLCRAG_FAST_LLM_BACKEND=anthropic         # grading, query rewriting
SDLCRAG_FAST_LLM_MODEL=claude-haiku-5-5
SDLCRAG_EXTRACTION_BACKEND=anthropic       # paper facts
SDLCRAG_EXTRACTION_MODEL=claude-haiku-5-5
SDLCRAG_VISION_BACKEND=anthropic           # figure descriptions
SDLCRAG_VISION_MODEL=claude-haiku-5-5

# Cost controls (ADR-0014)
SDLCRAG_USE_BATCH_API=true
SDLCRAG_LLM_CACHE=true
SDLCRAG_DESCRIBE_FIGURES=true
SDLCRAG_FIGURE_AREA_THRESHOLD=0.05
# SDLCRAG_MAX_COST_USD=5

# --- arXiv (no key needed; fair use <= 1 request / 3 s is enforced by the client) ---
# SDLCRAG_HTTP_USER_AGENT=sdlcrag/0.1 (research RAG; +https://arxiv.org/help/api)

# --- Embeddings / reranker (local, Hugging Face) ---
SDLCRAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SDLCRAG_SPARSE_MODEL=Qdrant/bm25
SDLCRAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SDLCRAG_DEVICE=mps

# --- Docker host ports (compose.yaml reads them from .env; change them if the defaults are taken) ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OPENFGA_HTTP_PORT=8080
OPENFGA_GRPC_PORT=8081

# --- Qdrant (keep the port in sync with QDRANT_HTTP_PORT) ---
SDLCRAG_QDRANT_URL=http://localhost:6333
SDLCRAG_QDRANT_COLLECTION=papers

# --- OpenFGA ---
SDLCRAG_OPENFGA_API_URL=http://localhost:8080
SDLCRAG_OPENFGA_STORE_ID=
SDLCRAG_OPENFGA_MODEL_ID=

# --- Langfuse (optional, `docker compose --profile observability up -d`) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Paths ---
SDLCRAG_DATA_DIR=data

# Knowledge graph (Neo4j)
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# SDLCRAG_NEO4J_URI=bolt://localhost:7687
# SDLCRAG_NEO4J_PASSWORD=sdlcrag-dev
