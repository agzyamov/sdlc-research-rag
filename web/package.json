{
  "name": "sdlcrag-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "orval --config orval.config.ts",
    "check:api": "pnpm gen:api && git diff --exit-code -- src/lib/api/generated.ts",
    "typecheck": "tsc -b",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm check:api && pnpm typecheck && pnpm lint && pnpm depcruise",
    "e2e": "playwright test",
    "e2e:live": "E2E_LIVE=1 playwright test",
    "e2e:llm": "E2E_LIVE=1 E2E_LLM=1 playwright test"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.36",
    "@assistant-ui/react-data-stream": "^0.12.41",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-sigma/core": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "culori": "^4.0.2",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "lucide-react": "^1.73.0",
    "nuqs": "^2.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sigma": "^4.0.6",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@swc/core": "^1.16.22",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.2",
    "graphology-types": "^0.24.8",
    "orval": "^8.48.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
